<%- include("partials/header.ejs") %>

<body class="bg-light">

<div class="container py-5">

  <h2 class="text-center mb-4">Update Quote</h2>

  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow-sm p-4">

        <form method="POST" action="/quote/edit">

          <input type="hidden" name="quoteId" value="<%= quoteInfo[0].quoteId %>">

          <div class="mb-3">
            <label class="form-label">Quote</label>
            <input 
              type="text" 
              name="quote" 
              class="form-control"
              value="<%= quoteInfo[0].quote %>" 
              required
            >
          </div>

          <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-select" required>
              <option value="">Select Category</option>
              <% categories.forEach(c => { %>
                <option value="<%= c.category %>" 
                  <%= quoteInfo[0].category === c.category ? 'selected' : '' %>>
                  <%= c.category %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Likes</label>
            <input 
              type="number" 
              name="likes" 
              class="form-control"
              value="<%= quoteInfo[0].likes %>"
            >
          </div>

          <div class="mb-3">
            <label class="form-label">Author</label>
            <select name="authorId" class="form-select" required>
              <option value="">Select Author</option>
              <% authors.forEach(author => { %>
                <option value="<%= author.authorId %>"
                  <%= quoteInfo[0].authorId == author.authorId ? 'selected' : '' %>>
                  <%= author.firstName %> <%= author.lastName %>
                </option>
              <% }) %>
            </select>
          </div>

          <button class="btn btn-primary w-100">Update Quote</button>

        </form>

      </div>

    </div>
  </div>

</div>

<%- include("partials/footer.ejs") %>
</body>
</html>