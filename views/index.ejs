<%- include("partials/header.ejs") %>

<body class="bg-light">

<div class="container py-5">

  <h1 class="display-5 fw-bold text-center mb-4">
    Famous Quotes - Admin Section
  </h1>

  <hr class="mb-5">

  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow-sm p-4">

        <div class="row text-center">

          <div class="col-6">
            <form action="/author/new" class="mb-3">
              <button class="btn btn-primary w-100">Add Author</button>
            </form>

            <form action="/quote/new">
              <button class="btn btn-primary w-100">Add Quote</button>
            </form>
          </div>

          <div class="col-6">
            <form action="/authors" class="mb-3">
              <button class="btn btn-primary w-100">List Authors</button>
            </form>

            <form action="/quotes">
              <button class="btn btn-primary w-100">List Quotes</button>
            </form>
          </div>

        </div>

      </div>

    </div>
  </div>

</div>

<%- include("partials/footer.ejs") %>
</body>
</html>